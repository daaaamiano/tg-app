# Configure these through your hosting dashboard's private environment settings.
# Production refuses local .env files and requires HTTPS.
NODE_ENV=production
APP_ORIGIN=https://YOUR-PROJECT.vercel.app
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional; defaults to the bot's numeric ID.
TELEGRAM_LOGIN_CLIENT_ID=
# One PostgreSQL database for sessions and approved groups.
# Use your provider's pooled connection URL; keep it private.
DATABASE_URL=
