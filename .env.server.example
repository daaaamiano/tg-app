# Server-only credentials; copy to .env.server.local (ignored by Git).
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
# Telegram application credentials from https://my.telegram.org/apps.
# Required for complete roster retrieval via MTProto with bot authentication.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional Telegram Login Client ID from BotFather; defaults to the bot's numeric ID.
# Register the preview origin under BotFather → Bot Settings → Login Widget → Allowed URLs.
TELEGRAM_LOGIN_CLIENT_ID=
