# Mock data is the default. Switch to api when your event backend is available.
VITE_DATA_SOURCE=mock
# API base URL; e.g. https://api.example.com (never put a bot token here)
VITE_API_BASE_URL=
# Telegram bot username, without @. Configure its Main Mini App in BotFather.
VITE_TELEGRAM_BOT_USERNAME=

# Public WorkOS Client ID from your new application. No API key is needed in this frontend.
VITE_WORKOS_CLIENT_ID=
# Optional locally; required for a production website. Hostname only, e.g. auth.events.example.com.
VITE_WORKOS_API_HOSTNAME=
# Set true only for a hosted staging sandbox without a custom auth domain.
# Local `npm run dev` enables SDK development mode automatically.
VITE_WORKOS_DEV_MODE=false
